#!/usr/bin/env bash
xset r rate 220 90

# Output names change with the NVIDIA PRIME mode, so look them up instead of
# hardcoding DP-4 / eDP-1-1.
laptop=$(xrandr --query | awk '/ connected/ && $1 ~ /^eDP/ { print $1; exit }')
external=$(xrandr --query | awk '/ connected/ && $1 !~ /^eDP/ { print $1; exit }')
if [ -n "$external" ] && [ -n "$laptop" ]; then
  xrandr --output "$external" --auto --primary --output "$laptop" --auto --right-of "$external"
fi

# sudo service usbmuxd restart
# pkill barrier || true && barrier &
# pkill indicator-sound-switcher || true && indicator-sound-switcher &
# pkill droidcam || true && droidcam &
pkill clipit || true && clipit &
